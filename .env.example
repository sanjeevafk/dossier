# Model API Keys (Supported: Groq, OpenRouter, OpenAI, Anthropic, Gemini, OrcaRouter, or local)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ORCAROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Live Web Recon providers (optional — ground market evidence in real search results)
EXA_API_KEY=
TAVILY_API_KEY=

# Server auth — required in production for all non-GET routes
DOSSIER_API_KEY=
# CORS allowlist (comma-separated); defaults to localhost in dev
ALLOWED_ORIGINS=http://localhost:3000
# Persistent data dir (dossiers.db + reports/); defaults to ./data
DOSSIER_DATA_DIR=./data

# MCP Server Endpoints (Optional external MCPs)
SEARCH_MCP_URL=
SANDBOX_PROVIDER=local

# LLM backend selection: "agy" (authenticated CLI, no API keys) | "api" (keys only) | unset = auto
DOSSIER_LLM_BACKEND=
# Model for the agy CLI backend (see `agy models`)
AGY_MODEL=gemini-3.8-flash-medium
# Print-mode timeout for agy turns, seconds
AGY_PRINT_TIMEOUT_S=120
