# Model API Keys (Supported: Groq, OpenRouter, OpenAI, Gemini, OrcaRouter, or local OpenAI-compatible endpoints)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=orcarouter/free
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Live Web Recon providers (optional — ground market evidence in real search results)
EXA_API_KEY=
TAVILY_API_KEY=

# Server auth — required in production for all non-GET routes
DOSSIER_API_KEY=
# CORS allowlist (comma-separated); defaults to localhost in dev
ALLOWED_ORIGINS=http://localhost:3000
# Persistent data dir (dossiers.db + reports/); defaults to ./data
DOSSIER_DATA_DIR=./data

# MCP Server Endpoints (Optional external MCPs)
SEARCH_MCP_URL=
SANDBOX_PROVIDER=local

# Pluggable OpenAI-compatible endpoint (vLLM, Ollama, LMStudio, LiteLLM, or custom proxy)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Pluggable external CLI runner (e.g. `ollama run llama3`)
LLM_CLI_CMD=
LLM_CLI_TIMEOUT_S=120

# LLM backend selection: "cli" (external CLI) | "api" (direct HTTP API endpoints) | unset = auto
DOSSIER_LLM_BACKEND=
