{
  "name": "@sanjeevafk/dossier",
  "version": "0.2.1",
  "description": "Adversarial Multi-Agent Idea Intelligence Platform",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanjeevafk/dossier.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "public",
    "scripts/*.py",
    "skills",
    "dossier.mcp.json",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "dossier": "./dist/cli.js",
    "dossier-mcp": "./dist/mcp-server.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsc",
    "build:css": "npx -y tailwindcss@3.4.17 -i ./public/styles.css -o ./public/dist.css --content './public/**/*.{html,js}' --minify",
    "build": "npm run build:css && tsc && (git rev-parse --short HEAD > dist/.version 2>/dev/null || true) && cp src/tools/decision_model.py dist/tools/ && mkdir -p dist/scripts && cp scripts/simulate_monte_carlo.py scripts/simulate_sobol.py scripts/export_pdf.py dist/scripts/ || node -e 'if (!require(\"fs\").existsSync(\"dist/server.js\")) process.exit(1); console.log(\"Using pre-built dist\")'",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server.ts",
    "mcp:prod": "node dist/mcp-server.js",
    "server": "tsx src/server.ts",
    "benchmark": "tsx src/benchmark.ts",
    "replay": "tsx src/benchmark.ts --replay",
    "replay:snapshot": "tsx scripts/replay_snapshot.ts",
    "replay:diff": "tsx scripts/replay_diff.ts",
    "monitor": "tsx scripts/monitor.ts",
    "test:stress": "tsx src/stress-test.ts",
    "test:decision": "NODE_ENV=test node --test test/decision_model.test.mjs",
    "test": "NODE_ENV=test node --test test/*.test.mjs"
  },
  "keywords": [
    "ai-agent",
    "mcp",
    "idea-validation",
    "multi-agent",
    "swarm"
  ],
  "author": "sanjeevafk",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
