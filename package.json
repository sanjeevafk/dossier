{
  "name": "@sanjeevafk/dossier",
  "version": "0.2.1",
  "description": "Adversarial Multi-Agent Idea Intelligence Platform",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanjeevafk/dossier.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "public",
    "scripts/*.py",
    "dossier.mcp.json",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "dossier": "./dist/cli.js",
    "dossier-mcp": "./dist/mcp-server.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsc",
    "build:css": "tailwindcss -i ./public/styles.css -o ./public/dist.css --content './public/**/*.{html,js}' --minify",
    "build": "pnpm run build:css && tsc && pnpm run build:assets && (git rev-parse --short HEAD > dist/.version 2>/dev/null || true)",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server.ts",
    "mcp:prod": "node dist/mcp-server.js",
    "server": "tsx src/server.ts",
    "benchmark": "tsx src/benchmark.ts",
    "replay": "tsx src/benchmark.ts --replay",
    "replay:snapshot": "tsx scripts/replay_snapshot.ts",
    "replay:diff": "tsx scripts/replay_diff.ts",
    "monitor": "tsx scripts/monitor.ts",
    "test:stress": "tsx src/stress-test.ts",
    "test:decision": "NODE_ENV=test node --import tsx --test test/decision_model.test.mjs",
    "test": "NODE_ENV=test node --import tsx --test test/*.test.mjs",
    "build:assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/tools',{recursive:true});fs.mkdirSync('dist/scripts',{recursive:true});fs.copyFileSync('src/tools/decision_model.py','dist/tools/decision_model.py');for(const f of ['simulate_monte_carlo.py','simulate_sobol.py','export_pdf.py'])fs.copyFileSync('scripts/'+f,'dist/scripts/'+f)\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "eval": "tsx scripts/run_eval.ts",
    "eval:heuristic": "EVAL_LLM=0 tsx scripts/run_eval.ts"
  },
  "keywords": [
    "ai-agent",
    "mcp",
    "idea-validation",
    "multi-agent",
    "swarm"
  ],
  "author": "sanjeevafk",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.5",
    "eslint": "^10.15.0",
    "tailwindcss": "3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2"
  }
}
