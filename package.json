{
  "name": "dossier-ai",
  "version": "0.1.0",
  "description": "Adversarial Multi-Agent Idea Intelligence Platform",
  "main": "dist/index.js",
  "bin": {
    "dossier": "./dist/cli.js",
    "dossier-mcp": "./dist/mcp-server.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsc",
    "build": "tsc && cp src/tools/decision_model.py dist/tools/ && mkdir -p dist/scripts && cp scripts/simulate_monte_carlo.py scripts/simulate_sobol.py scripts/export_pdf.py dist/scripts/ || node -e 'if (!require(\"fs\").existsSync(\"dist/server.js\")) process.exit(1); console.log(\"Using pre-built dist\")'",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server.ts",
    "mcp:prod": "node dist/mcp-server.js",
    "server": "tsx src/server.ts",
    "benchmark": "tsx src/benchmark.ts",
    "replay": "tsx src/benchmark.ts --replay",
    "replay:snapshot": "tsx scripts/replay_snapshot.ts",
    "replay:diff": "tsx scripts/replay_diff.ts",
    "monitor": "tsx scripts/monitor.ts",
    "test:stress": "tsx src/stress-test.ts",
    "test:decision": "NODE_ENV=test node --test test/decision_model.test.mjs",
    "test": "NODE_ENV=test node --test test/*.test.mjs"
  },
  "keywords": [
    "ai-agent",
    "mcp",
    "idea-validation",
    "multi-agent",
    "swarm"
  ],
  "author": "sanjeevafk",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "commander": "^13.1.0",
    "compromise": "^14.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "onnxruntime-node": "1.14.0",
    "openai": "^7.5.0",
    "p-queue": "^10.0.0",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
